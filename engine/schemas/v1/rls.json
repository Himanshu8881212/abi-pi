{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.abi.invalid/v1/rls.json",
  "title": "Row-level security",
  "description": "security/rls.json: row-level rules per project (PRD SE-6, SC-3, DECISIONS D-42). A rule restricts Viewers of the project to the rows of `table` whose `column` holds one of their listed values; a Viewer not listed sees no rows (default deny). A rule on a dimension filters every fact related to it. Changing it requires Owner and a confirmation.",
  "type": "object",
  "required": ["$schema", "rules"],
  "properties": {
    "$schema": {"const": "https://schema.abi.invalid/v1/rls.json"},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "table", "column", "users"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "table": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,65}$", "description": "a model table (ML predictions tables ml_<model id> may hold a hyphen)"},
          "column": {"type": "string", "minLength": 1},
          "users": {
            "type": "object",
            "description": "{user ID: the values of `column` this Viewer may see}",
            "patternProperties": {
              "^[1-9][0-9]*$": {"type": "array", "items": {"type": ["string", "number", "boolean"]}}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "columns": {
      "type": "array",
      "description": "Column rules (DECISIONS D-110): every Viewer of the project is denied the values of `columns` of `table` (absent from every read; a query naming one is refused). Rule IDs share one namespace with `rules`.",
      "items": {
        "type": "object",
        "required": ["id", "table", "columns"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "table": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,65}$"},
          "columns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "examples": [
    {"$schema": "https://schema.abi.invalid/v1/rls.json", "rules": [
      {"id": "region", "table": "customers", "column": "region", "users": {"12": ["North", "East"], "14": ["South"]}}
    ]},
    {"$schema": "https://schema.abi.invalid/v1/rls.json", "rules": [], "columns": [
      {"id": "pay", "table": "employees", "columns": ["salary", "bonus"]}
    ]}
  ]
}
