{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.abi.invalid/v1/ml.json",
  "title": "ML model",
  "description": "ml/<id>.json: an ML model (ML-1..ML-4): a forecast, classification, regression, clustering or anomaly detection. It trains on a dataset (model/datasets.json), whose rows come from the semantic engine (ML-2). No code (§2 non-goal \"custom model code\"): the platform picks the estimator and guards the training (ML-3); `search`/`space` only tune a few bounded settings of the task's two candidates (D-135). Retraining on a schedule is a flow with a `train` step (§11 #3). Fitted models and their metrics live in the registry (ML-4), not in Git.",
  "type": "object",
  "required": ["$schema", "id", "name", "task", "dataset"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"const": "https://schema.abi.invalid/v1/ml.json"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$", "description": "Equals the file name"},
    "name": {"type": "string", "minLength": 1, "description": "Display name, shown to users"},
    "description": {"type": "string"},
    "task": {"enum": ["forecast", "classification", "regression", "clustering", "anomaly"]},
    "dataset": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,62}$", "description": "Dataset ID in model/datasets.json: the training rows"},
    "target": {"type": "string", "minLength": 1, "description": "What to predict: a measure ID or a table.column dimension of the dataset's query. Required, except for clustering and anomaly, which have none"},
    "features": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1},
                 "description": "Measure IDs and table.column dimensions of the dataset's query to learn from; default: all its other columns (clustering and anomaly: all but row identity, i.e. a table's key and date-table columns). Not for forecast, which forecasts the target alone for each combination of the query's other dimensions"},
    "time": {"type": "string", "pattern": "^[^.\\s][^.]*\\.[^.]+$", "description": "A date-table dimension of the dataset's query, the grain the question asks for (calendar.day, .week with .week_year, .month or .quarter with .year, .year): required for forecast and seasonal anomaly detection; for classification and regression the holdout is then the latest periods"},
    "horizon": {"type": "integer", "minimum": 1, "maximum": 366, "description": "Forecast periods ahead (up to a year of days), covering the asked period in full: next quarter = to its end (by day 90-92, by week 13, by month 3)"},
    "k": {"type": "integer", "minimum": 2, "maximum": 10, "description": "Clustering: a fixed number of groups; default: auto, the k in 2..10 with the best silhouette (k-means) or BIC (Gaussian mixture)"},
    "method": {"enum": ["auto", "lightgbm", "ets", "random_forest", "kmeans", "gmm", "isolation_forest", "seasonal"],
               "description": "Default auto: trains the task's two candidates and keeps the better (D-99): on the holdout for forecast (lightgbm, ets), classification and regression (lightgbm, random_forest; linear and arima are retired: use auto); by BIC on the numeric columns for clustering (kmeans, gmm: a Gaussian mixture); for anomaly (isolation_forest, seasonal: needs time, so auto without time trains the Isolation Forest only) the seasonal rule is kept when the same period in earlier seasons predicts the measures better than the period before"},
    "search": {"type": "object", "additionalProperties": false, "required": ["strategy"],
               "description": "Forecast, classification and regression (D-135): tune each candidate trained before comparing them. Each candidate tries its defaults plus settings from `space` (grid: every combination in order; random: sampled), scored on folds of the training part only (rolling-origin by period with `time`, else stratified k-fold), never on the holdout it reports; the best setting is kept. Trials are recorded with the run",
               "properties": {
                 "strategy": {"enum": ["grid", "random"]},
                 "trials": {"type": "integer", "minimum": 2, "maximum": 50, "description": "Settings per candidate, its defaults included; default 10"},
                 "time_budget_s": {"type": "integer", "minimum": 10, "maximum": 1800, "description": "Seconds for the whole search, shared by the candidates; trials past it are skipped. Default 300"},
                 "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647, "description": "Random sampling and fold shuffling; default 0"}}},
    "space": {"type": "object", "additionalProperties": false,
              "description": "Settings each candidate searches (needs `search`): a list of values, or a {min, max} range (log: sampled on a log scale). A candidate not named here searches its default space",
              "properties": {
                "lightgbm": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {
                  "num_leaves": {"$ref": "#/$defs/leaves"},
                  "learning_rate": {"$ref": "#/$defs/rate"},
                  "n_estimators": {"$ref": "#/$defs/rounds"},
                  "min_child_samples": {"$ref": "#/$defs/leaf"},
                  "reg_lambda": {"$ref": "#/$defs/lambda"}}},
                "random_forest": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {
                  "n_estimators": {"$ref": "#/$defs/trees"},
                  "max_depth": {"$ref": "#/$defs/depth"},
                  "min_samples_leaf": {"$ref": "#/$defs/leaf"},
                  "max_features": {"$ref": "#/$defs/share"}}},
                "ets": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {
                  "model": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "pattern": "^[AMZ][NAMZ][NAMZ]$"},
                            "description": "AutoETS model codes: error (A, M, Z = auto), trend (N, A, M, Z), season (N, A, M, Z)"},
                  "damped": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": ["boolean", "null"]}, "description": "null: AutoETS decides"}}}}},
    "params": {"type": "object", "additionalProperties": false, "minProperties": 1, "maxProperties": 1,
               "description": "A fixed setting of `method` (use_ml_trial: one trial of a search, ML-ZOO.2): every training uses it, with no search. Keyed by the method, like `space`; one value per setting",
               "properties": {
                 "lightgbm": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {
                   "num_leaves": {"$ref": "#/$defs/leaves/oneOf/0/items"},
                   "learning_rate": {"$ref": "#/$defs/rate/oneOf/0/items"},
                   "n_estimators": {"$ref": "#/$defs/rounds/oneOf/0/items"},
                   "min_child_samples": {"$ref": "#/$defs/leaf/oneOf/0/items"},
                   "reg_lambda": {"$ref": "#/$defs/lambda/oneOf/0/items"}}},
                 "random_forest": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {
                   "n_estimators": {"$ref": "#/$defs/trees/oneOf/0/items"},
                   "max_depth": {"$ref": "#/$defs/depth/oneOf/0/items"},
                   "min_samples_leaf": {"$ref": "#/$defs/leaf/oneOf/0/items"},
                   "max_features": {"$ref": "#/$defs/share/oneOf/0/items"}}},
                 "ets": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {
                   "model": {"$ref": "#/properties/space/properties/ets/properties/model/items"},
                   "damped": {"type": ["boolean", "null"]}}}}}
  },
  "$defs": {
    "leaves": {"description": "Leaves per tree 2..127", "oneOf": [{"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "integer", "minimum": 2, "maximum": 127}},
                      {"type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": {"min": {"type": "integer", "minimum": 2, "maximum": 127}, "max": {"type": "integer", "minimum": 2, "maximum": 127}}}]},
    "rounds": {"description": "Boosting rounds 10..500", "oneOf": [{"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "integer", "minimum": 10, "maximum": 500}},
                      {"type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": {"min": {"type": "integer", "minimum": 10, "maximum": 500}, "max": {"type": "integer", "minimum": 10, "maximum": 500}}}]},
    "trees": {"description": "Trees 10..100 (D-17: stored as JSON arrays)", "oneOf": [{"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "integer", "minimum": 10, "maximum": 100}},
                      {"type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": {"min": {"type": "integer", "minimum": 10, "maximum": 100}, "max": {"type": "integer", "minimum": 10, "maximum": 100}}}]},
    "depth": {"description": "Tree depth 2..10 (D-17: at most 2,047 nodes per tree)", "oneOf": [{"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "integer", "minimum": 2, "maximum": 10}},
                      {"type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": {"min": {"type": "integer", "minimum": 2, "maximum": 10}, "max": {"type": "integer", "minimum": 2, "maximum": 10}}}]},
    "leaf": {"description": "Rows per leaf 1..500", "oneOf": [{"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "integer", "minimum": 1, "maximum": 500}},
                      {"type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": {"min": {"type": "integer", "minimum": 1, "maximum": 500}, "max": {"type": "integer", "minimum": 1, "maximum": 500}}}]},
    "rate": {"description": "Learning rate 0.005..0.5", "oneOf": [{"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "number", "minimum": 0.005, "maximum": 0.5}},
                      {"type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": {"min": {"type": "number", "minimum": 0.005, "maximum": 0.5}, "max": {"type": "number", "minimum": 0.005, "maximum": 0.5}, "log": {"type": "boolean"}}}]},
    "lambda": {"description": "L2 regularisation 0..100", "oneOf": [{"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "number", "minimum": 0, "maximum": 100}},
                      {"type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": {"min": {"type": "number", "minimum": 0, "maximum": 100}, "max": {"type": "number", "minimum": 0, "maximum": 100}}}]},
    "share": {"description": "Share of features per split 0.1..1", "oneOf": [{"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "number", "minimum": 0.1, "maximum": 1}},
                      {"type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": {"min": {"type": "number", "minimum": 0.1, "maximum": 1}, "max": {"type": "number", "minimum": 0.1, "maximum": 1}}}]}
  },
  "allOf": [
    {"if": {"properties": {"task": {"const": "forecast"}}},
     "then": {"required": ["time"], "not": {"required": ["features"]}, "properties": {"method": {"enum": ["auto", "lightgbm", "ets"]}}},
     "else": {"not": {"required": ["horizon"]}}},
    {"if": {"properties": {"task": {"enum": ["classification", "regression"]}}}, "then": {"properties": {"method": {"enum": ["auto", "lightgbm", "random_forest"]}}}},
    {"if": {"properties": {"task": {"enum": ["clustering", "anomaly"]}}}, "then": {"not": {"required": ["target"]}}, "else": {"required": ["target"]}},
    {"if": {"properties": {"task": {"const": "clustering"}}}, "then": {"properties": {"method": {"enum": ["auto", "kmeans", "gmm"]}}}, "else": {"not": {"required": ["k"]}}},
    {"if": {"properties": {"task": {"const": "anomaly"}}}, "then": {"properties": {"method": {"enum": ["auto", "isolation_forest", "seasonal"]}}}},
    {"if": {"properties": {"method": {"const": "seasonal"}}, "required": ["method"]}, "then": {"required": ["time"]}},
    {"if": {"properties": {"task": {"enum": ["clustering", "anomaly"]}}}, "then": {"not": {"anyOf": [{"required": ["search"]}, {"required": ["space"]}, {"required": ["params"]}]}}},
    {"if": {"properties": {"task": {"const": "forecast"}}}, "then": {"properties": {"space": {"not": {"required": ["random_forest"]}}, "params": {"not": {"required": ["random_forest"]}}}},
     "else": {"properties": {"space": {"not": {"required": ["ets"]}}, "params": {"not": {"required": ["ets"]}}}}},
    {"not": {"required": ["params", "search"]}}
  ],
  "dependentRequired": {"space": ["search"], "params": ["method"]},
  "examples": [
    {"$schema": "https://schema.abi.invalid/v1/ml.json", "id": "churn", "name": "Customer churn", "task": "classification",
     "dataset": "customer-month", "target": "customers.churned", "features": ["sales", "orders", "customers.segment"], "time": "calendar.month"},
    {"$schema": "https://schema.abi.invalid/v1/ml.json", "id": "demand-forecast", "name": "Demand forecast", "task": "forecast",
     "dataset": "monthly-demand", "target": "units", "time": "calendar.month", "horizon": 6},
    {"$schema": "https://schema.abi.invalid/v1/ml.json", "id": "churn-tuned", "name": "Customer churn (tuned)", "task": "classification",
     "dataset": "customer-month", "target": "customers.churned", "time": "calendar.month",
     "search": {"strategy": "random", "trials": 20, "time_budget_s": 600, "seed": 7},
     "space": {"lightgbm": {"num_leaves": [15, 31, 63], "learning_rate": {"min": 0.01, "max": 0.3, "log": true}},
               "random_forest": {"max_depth": {"min": 4, "max": 10}}}},
    {"$schema": "https://schema.abi.invalid/v1/ml.json", "id": "demand-tuned", "name": "Demand forecast (tuned)", "task": "forecast",
     "dataset": "monthly-demand", "target": "units", "time": "calendar.month", "horizon": 6,
     "search": {"strategy": "grid"}, "space": {"ets": {"model": ["ZZZ", "AAA"], "damped": [null, true]}}},
    {"$schema": "https://schema.abi.invalid/v1/ml.json", "id": "churn-fixed", "name": "Customer churn (fixed setting)", "task": "classification",
     "dataset": "customer-month", "target": "customers.churned", "time": "calendar.month", "method": "lightgbm",
     "params": {"lightgbm": {"num_leaves": 63, "learning_rate": 0.05}}},
    {"$schema": "https://schema.abi.invalid/v1/ml.json", "id": "customer-groups", "name": "Customer groups", "task": "clustering",
     "dataset": "customer-month", "features": ["sales", "orders", "customers.segment"], "method": "gmm"},
    {"$schema": "https://schema.abi.invalid/v1/ml.json", "id": "unusual-demand", "name": "Unusual demand", "task": "anomaly",
     "dataset": "monthly-demand", "time": "calendar.month", "method": "seasonal"}
  ]
}
