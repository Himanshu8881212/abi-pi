# Copy to .env (git-ignored) and fill in. Only ABI_USER and ABI_PASSWORD are required.
ABI_USER=admin                 # the workspace owner, created on the first start
ABI_PASSWORD=                  # 8 characters or more, e.g. the output of: openssl rand -base64 18
ABI_PROJECT=main               # the project to open first (created if missing)
# ABI_PORT=8790                # the port on this machine, when 8790 is taken
# ABI_LLM_BASE=https://api.openai.com/v1   # optional: one OpenAI-compatible model endpoint...
# ABI_LLM_KEY=                              # ...its key...
# ABI_LLM_MODEL=gpt-5                        # ...and the model's id there. Or connect providers in the app: Govern > Settings
# ABI_SECRET_KEY=              # optional Fernet key that encrypts saved API keys (default: a key file in the volume)
# ABI_PUBLIC_URL=https://abi.example.com   # optional: the address people open (emailed links, single sign-on); with HTTPS on, https://ABI_DOMAIN
# ABI_SOURCE_URL=https://git.example.com/our-abi   # you changed ABI and serve it to others: where its source is (AGPL-3.0 §13; default: github.com/Himanshu8881212/abi-pi)
# ABI_HEAVY_CONCURRENCY=1      # loads, query copies and ML trainings at a time (1 or 2); 2 needs memory for both
# ABI_RUNNER_IDLE=180          # seconds with no heavy job before the heavy worker stops and its memory goes back
# ABI_MAX_AGENTS=8             # chats whose agent runs at once (a Node process of about 100 MB each); the next waits its turn
# ABI_QUERY_TIMEOUT=60         # seconds a question's or a page visual's read may run before it is stopped
# ABI_RLS_SHARED_ROWS=1000000  # rows all reads computed once for everyone with row-level security may hold together (0: each their own)
# ABI_PG_POOL=20               # Postgres connections each engine process keeps open for reuse (0: a new one each time)
# ABI_DUCKDB_MEMORY_LIMIT=1500MB  # DuckDB's memory for one project's queries and loads in each engine process (it spills to disk above it)
# ABI_DUCKDB_THREADS=           # DuckDB threads for one project in each engine process; empty: half the CPUs
# ABI_QUERY_CACHE_MB=256          # query results kept for reuse, in megabytes per project in each engine process
# ABI_INLINE_ROWS=4400000      # a load of more rows (about 20 s of loading) answers at once and loads in the background
# ABI_RENDER_TIMEOUT=120       # seconds a PDF, PNG or PowerPoint export may take; two render at a time, the next waits
# ABI_VIDEO_TIMEOUT=900        # seconds a video export may take before it is stopped
# HTTPS (README: Use it from other devices): Caddy in front with a certificate, started by docker compose up -d too
# COMPOSE_PROFILES=https
# ABI_DOMAIN=abi.example.com     # the name or address people open: a public name gets its certificate by itself
# ABI_BIND=0.0.0.0               # with ABI_DOMAIN, ABI's own port (plain HTTP) listens on this machine only: this opens it again
# ABI_TLS=internal               # a LAN name or an IP address: Caddy's own certificate authority instead
# ABI_TLS_CERT=/etc/ssl/abi.crt  # or your own certificate (the full chain) and its key: files on this machine
# ABI_TLS_KEY=/etc/ssl/abi.key
# ABI_HTTPS_PORT=8443            # when 443 is taken (ABI_HTTP_PORT for 80); a public certificate needs one of the two kept
# SQL clients (psql, DBeaver, BI tools) with a personal token as the password (README: Data out): off unless set
# ABI_SQL_PORT=5433             # the SQL endpoint's port; it starts only with TLS below, or with ABI_SQL_BIND=127.0.0.1
# ABI_SQL_BIND=127.0.0.1        # only with ABI_SQL_PORT: this machine only (the default with ABI_DOMAIN), plain allowed
# ABI_SQL_TLS_CERT=/etc/ssl/abi.crt  # a certificate (the full chain) and its key, readable by uid 10001; with your own
# ABI_SQL_TLS_KEY=/etc/ssl/abi.key   # files for HTTPS, the same two: ${ABI_TLS_CERT} and ${ABI_TLS_KEY}
# Heavy jobs (loads, query copies, heavy flow runs, ML) in a container of their own, with its own memory limit
# (README: Heavy jobs and the runner); with HTTPS too: COMPOSE_PROFILES=https,runner
# COMPOSE_PROFILES=runner
# ABI_RUNNER_MEMORY=4g                 # the runner container's memory (and swap) limit
# ABI_RUNNER_DUCKDB_MEMORY_LIMIT=2GB   # DuckDB's memory per project in the runner (it spills to disk above it)
# ABI_VOLUME=abi-pi_abi-pi-data            # only for an install from 1.0 (scripts/upgrade.sh sets it)
